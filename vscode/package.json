{
  "name": "vesna",
  "displayName": "Vesna",
  "description": "A coding agent with spec-driven development built in — the chat, the garden and the review findings beside your code.",
  "version": "0.1.0",
  "publisher": "seasons-ai",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/seasons-ai/vesna", "directory": "vscode" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Programming Languages"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {},
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": { "markdown-it": "^14.3.2", "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": { "@types/bun": "^1.4.2", "@types/markdown-it": "^14.2.0", "@types/node": "^20.19.43", "@types/react": "^18.3.31", "@types/react-dom": "^18.3.7", "@types/vscode": "^1.137.0", "@vscode/vsce": "^3.9.2", "esbuild": "^0.23.1", "typescript": "^5.9.3" }
}
